local mp = require("mp")
local msg = require("mp.msg")
local utils = require("mp.utils")

local applying = false
local manual_modes = {
    { cap = 4, model = "auto", label = "auto up to x4" },
    { cap = 3, model = "4.26", label = "4.26 up to x3" },
    { cap = 2, model = "4.26", label = "4.26 x2" },
    { cap = 4, model = "last-4k", label = "4K fallback profile" },
    { cap = 0, model = nil, label = "off" },
}
local manual_index = 1
local active_factor = 0
local active_model = nil
local last_cache_warning = ""
local last_cache_warning_time = 0
local build_jobs = {}
local apply

local function current_script_dir()
    local ok, dir = pcall(mp.get_script_directory)
    if dir then return dir end
    local source = debug.getinfo(1, "S").source
    if source and source:sub(1, 1) == "@" then
        return source:sub(2):match("^(.*)[/\\][^/\\]+$")
    end
    return "."
end

local script_dir = current_script_dir()
local config_dir = utils.join_path(script_dir, "..")
local portable_config_dir = script_dir:match("^(.*)[/\\]mpv[/\\]scripts$") or utils.join_path(config_dir, "..")
local portable_dir = portable_config_dir:match("^(.*)[/\\]config$") or utils.join_path(portable_config_dir, "..")

local function read_runtime_conf()
    local conf = {}
    local path = mp.find_config_file("runtime.conf") or utils.join_path(config_dir, "runtime.conf")
    if not path then
        return conf
    end

    local f = io.open(path, "r")
    if not f then
        return conf
    end
    for line in f:lines() do
        local key, value = line:match("^%s*([%w_%-]+)%s*=%s*(.-)%s*$")
        if key and not key:match("^#") then
            conf[key] = value
        end
    end
    f:close()
    return conf
end

local function number_or_nil(value)
    local n = tonumber(value or "")
    if n and n > 0 then
        return n
    end
    return nil
end

local function clamp_factor(value)
    local n = math.floor(tonumber(value or "") or 4)
    if n > 4 then return 4 end
    if n < 0 then return 0 end
    return n
end

local function clamp_positive_int(value, default_value)
    local n = math.floor(tonumber(value or "") or default_value)
    if n < 1 then return default_value end
    return n
end

local function normalize_model(value)
    if value == "4.26-half" or value == "4.26-scale0.5" or value == "4.26-half-x2" then
        return "4.26-half"
    end
    if value == "4.26-down1080" or value == "4.26-down1080-vsr" or value == "down1080" then
        return "4.26-down1080"
    end
    return "4.26"
end

local function bool_enabled(value)
    value = tostring(value or ""):lower()
    return value == "1" or value == "yes" or value == "true" or value == "on"
end

local function lower_or_default(value, default_value)
    value = tostring(value or ""):lower()
    if value == "" then
        return default_value
    end
    return value
end

local function unique_numbers(values)
    local seen = {}
    local out = {}
    for _, value in ipairs(values) do
        value = math.floor(value)
        if value > 0 and not seen[value] then
            seen[value] = true
            table.insert(out, value)
        end
    end
    return out
end

local function ceil_to_multiple(value, multiple)
    return math.ceil(value / multiple) * multiple
end

local function cache_dimensions_for_model(model)
    local source_width = mp.get_property_native("width")
    local source_height = mp.get_property_native("height")
    if not source_width or not source_height then
        return {}, {}
    end

    local effective_width = source_width
    local effective_height = source_height
    if model == "4.26-down1080" and source_height > 1080 then
        effective_height = 1080
        effective_width = math.floor((source_width * effective_height) / source_height)
        if effective_width % 2 == 1 then
            effective_width = effective_width - 1
        end
    end

    local widths = unique_numbers({
        effective_width,
        ceil_to_multiple(effective_width, 16),
        ceil_to_multiple(effective_width, 32),
        ceil_to_multiple(effective_width, 64),
        ceil_to_multiple(effective_width, 128),
    })
    local heights = unique_numbers({
        effective_height,
        ceil_to_multiple(effective_height, 16),
        ceil_to_multiple(effective_height, 32),
        ceil_to_multiple(effective_height, 64),
        ceil_to_multiple(effective_height, 128),
    })
    return widths, heights
end

local function cache_dir_path()
    return utils.join_path(utils.join_path(portable_config_dir, "cache"), "rife-trt")
end

local function fallback_model_cache_dir_path()
    return utils.join_path(utils.join_path(utils.join_path(utils.join_path(utils.join_path(portable_dir, "python"), "Lib"), "site-packages"), "vsrife"), "models")
end

local function trt_cache_has_engine(model)
    local widths, heights = cache_dimensions_for_model(model)
    if #widths == 0 or #heights == 0 then
        return false, "source dimensions are not available"
    end

    local scale_tokens = { "scale-1", "scale-1.0" }
    if model == "4.26-half" then
        scale_tokens = { "scale-0.5" }
    end

    local checked_any_dir = false
    for _, cache_dir in ipairs({ cache_dir_path(), fallback_model_cache_dir_path() }) do
        local files = utils.readdir(cache_dir, "files")
        if files then
            checked_any_dir = true
            for _, width in ipairs(widths) do
                for _, height in ipairs(heights) do
                    local dim_token = string.format("_%dx%d_", width, height)
                    for _, scale_token in ipairs(scale_tokens) do
                        for _, name in ipairs(files) do
                            if name:match("%.ts$") and
                                name:find("flownet_v4.26.pkl", 1, true) and
                                name:find(dim_token, 1, true) and
                                name:find(scale_token, 1, true) then
                                return true
                            end
                        end
                    end
                end
            end
        end
    end
    if not checked_any_dir then
        return false, "RIFE TensorRT cache directory is missing"
    end

    local scale_label = table.concat(scale_tokens, " or ")
    return false, string.format("missing engine for %s (%s)", model, scale_label)
end

local function warn_missing_cache(reason)
    local now = mp.get_time()
    if reason == last_cache_warning and (now - last_cache_warning_time) < 5.0 then
        return
    end
    last_cache_warning = reason
    last_cache_warning_time = now
    local message = "RIFE TRT cache missing: " .. reason .. ". Run install.ps1 install to precompile."
    msg.warn(message)
    mp.osd_message("RIFE cache missing; keeping current mode", 3.0)
end

local function profile_scale(model)
    if model == "4.26-half" then
        return 0.5
    end
    return 1.0
end

local function profile_downsamples(model)
    return model == "4.26-down1080"
end

local function build_key(model, factor)
    local width = mp.get_property_native("width") or 0
    local height = mp.get_property_native("height") or 0
    return string.format("%s-x%d-%dx%d", model or "none", factor or 0, width, height)
end

local function start_background_cache_build(model, factor, reason)
    local width = mp.get_property_native("width")
    local height = mp.get_property_native("height")
    if not width or not height then
        warn_missing_cache("source dimensions are not available")
        return false
    end

    local key = build_key(model, factor)
    if build_jobs[key] then
        mp.osd_message("RIFE cache is building in background", 2.0)
        return true
    end

    local python = utils.join_path(utils.join_path(portable_dir, "python"), "python.exe")
    local helper = utils.join_path(config_dir, "rife_trt_build_cache.py")
    if not utils.file_info(python) then
        warn_missing_cache("portable python.exe is missing")
        return false
    end
    if not utils.file_info(helper) then
        warn_missing_cache("rife_trt_build_cache.py is missing")
        return false
    end

    build_jobs[key] = true
    msg.warn("RIFE TRT cache missing: " .. reason .. ". Building in background.")
    mp.osd_message("Building RIFE TensorRT cache in background", 3.0)

    local args = {
        python,
        helper,
        "--width", tostring(width),
        "--height", tostring(height),
        "--model", "4.26",
        "--factor", tostring(factor),
        "--scale", tostring(profile_scale(model)),
        "--config-dir", config_dir,
        "--cache-dir", cache_dir_path(),
    }
    if profile_downsamples(model) then
        table.insert(args, "--downsample-1080")
    end

    mp.command_native_async({
        name = "subprocess",
        playback_only = false,
        capture_stdout = true,
        capture_stderr = true,
        args = args,
    }, function(success, result, error)
        build_jobs[key] = nil
        local status = result and result.status
        if success and status == 0 then
            msg.info("RIFE TensorRT cache build finished for " .. key)
            mp.osd_message("RIFE cache ready; enabling interpolation", 2.5)
            active_factor = nil
            active_model = nil
            apply()
        else
            local stderr = result and result.stderr or tostring(error or "unknown error")
            msg.error("RIFE TensorRT cache build failed for " .. key .. ": " .. stderr)
            mp.osd_message("RIFE cache build failed; see console log", 4.0)
        end
    end)
    return true
end

local function source_tier_max(conf, height)
    if height <= 720 then
        return clamp_factor(conf.max_factor_720)
    elseif height <= 1080 then
        return clamp_factor(conf.max_factor_1080)
    end
    return clamp_factor(conf.max_factor_4k)
end

local function source_tier_model(conf, height)
    if height <= 720 then
        return normalize_model(conf.rife_model_720)
    elseif height <= 1080 then
        return normalize_model(conf.rife_model_1080)
    end
    return normalize_model(conf.rife_model_4k)
end

local function display_refresh(conf)
    return number_or_nil(conf.display_refresh) or number_or_nil(os.getenv("RIFE_DISPLAY_REFRESH")) or mp.get_property_native("display-fps") or 60
end

local function display_size(conf, source_width, source_height)
    local cw = number_or_nil(conf.vsr_target_w)
    local ch = number_or_nil(conf.vsr_target_h)
    if cw and ch then
        return cw, ch
    end
    local ew = number_or_nil(os.getenv("VSR_TARGET_W"))
    local eh = number_or_nil(os.getenv("VSR_TARGET_H"))
    if ew and eh then
        return ew, eh
    end
    local dw = mp.get_property_native("display-width")
    local dh = mp.get_property_native("display-height")
    if dw and dh then
        return dw, dh
    end
    return source_width, source_height
end

local function downsample_vsr_scale(conf)
    local source_width = mp.get_property_native("width")
    local source_height = mp.get_property_native("height")
    if not source_width or not source_height or source_height <= 1080 then
        return nil
    end
    local effective_height = 1080
    local effective_width = math.floor((source_width * effective_height) / source_height)
    if effective_width % 2 == 1 then
        effective_width = effective_width - 1
    end
    local target_width, target_height = display_size(conf, source_width, source_height)
    local scale = math.min(target_width / effective_width, target_height / effective_height)
    scale = math.floor(scale * 10) / 10
    if scale > 4.0 then scale = 4.0 end
    if scale <= 1.0 then return nil end
    return scale
end

local function choose_factor(conf)
    local fps = mp.get_property_native("container-fps") or mp.get_property_native("estimated-vf-fps")
    local height = mp.get_property_native("height")
    if not fps or not height or fps <= 0 then
        return 0, nil, "missing source fps/height"
    end
    if fps > 60.0001 then
        return 0, nil, string.format("source %.3ffps > 60fps", fps)
    end

    local mode = manual_modes[manual_index]
    local cap = mode.cap
    if cap <= 0 then
        return 0, nil, "manual off"
    end

    local refresh = display_refresh(conf)
    local refresh_cap = math.floor((refresh + 0.01) / fps)
    local tier_cap = source_tier_max(conf, height)
    local factor = math.min(4, cap, tier_cap, refresh_cap)
    if factor < 2 then
        return 0, nil, string.format("refresh %.3fHz cannot fit %.3ffps x2", refresh, fps)
    end
    local model = mode.model
    if model == "auto" or model == nil then
        model = source_tier_model(conf, height)
    elseif model == "last-4k" then
        if height > 1080 and bool_enabled(conf.enable_4k_downsample_vsr) then
            model = "4.26-down1080"
            cap = 4
            factor = math.min(4, cap, tier_cap, refresh_cap)
        else
            model = "4.26-half"
            cap = 2
            factor = math.min(2, tier_cap, refresh_cap)
        end
    end
    if factor < 2 then
        return 0, nil, string.format("refresh %.3fHz cannot fit %.3ffps x2", refresh, fps)
    end
    return factor, model, string.format("fps %.3f, refresh %.3fHz, caps manual=%d tier=%d mode=%s", fps, refresh, cap, tier_cap, mode.label)
end

apply = function()
    if applying then return end
    local conf = read_runtime_conf()
    local factor, model, reason = choose_factor(conf)

    if factor == 0 and reason == "missing source fps/height" then
        return false
    end

    if active_factor == factor and active_model == model then
        return true
    end

    if factor > 0 and not bool_enabled(conf.allow_runtime_trt_build) then
        local cache_ok, cache_reason = trt_cache_has_engine(model)
        if not cache_ok then
            local build_mode = lower_or_default(conf.trt_cache_build, "background")
            if build_mode == "background" then
                start_background_cache_build(model, factor, cache_reason)
                return false
            elseif build_mode == "inline" then
                -- Fall through and let VapourSynth/vsrife build inside mpv.
            else
            warn_missing_cache(cache_reason)
            return false
            end
        end
    end

    applying = true
    if active_factor and active_factor > 0 then
        pcall(mp.commandv, "vf", "remove", "@vsr")
        pcall(mp.commandv, "vf", "remove", "@rife")
    end

    if factor > 0 then
        local script_name = string.format("rife-%s-x%d.vpy", model, factor)
        local script_path = "~~/" .. script_name
        local buffered_frames = clamp_positive_int(conf.rife_buffered_frames, 12)
        local concurrent_frames = clamp_positive_int(conf.rife_concurrent_frames, 4)
        mp.commandv("vf", "append", string.format("@rife:vapoursynth=file=%s:buffered-frames=%d:concurrent-frames=%d", script_path, buffered_frames, concurrent_frames))
        if model == "4.26-down1080" then
            local vsr_scale = downsample_vsr_scale(conf)
            if vsr_scale then
                mp.add_timeout(0.25, function()
                    mp.commandv("vf", "append", "@vsr:d3d11vpp=scale=" .. vsr_scale .. ":scaling-mode=nvidia")
                    msg.info(string.format("NVIDIA VSR: downsampled RIFE scale %.1fx", vsr_scale))
                end)
            end
        end
        msg.info(string.format("RIFE: %s x%d enabled (%s, buffered=%d, concurrent=%d)", model, factor, reason, buffered_frames, concurrent_frames))
        mp.osd_message(string.format("RIFE: %s x%d", model, factor), 1.5)
    else
        msg.info("RIFE: disabled (" .. reason .. ")")
        mp.osd_message("RIFE: off", 1.5)
    end
    active_factor = factor
    active_model = model
    applying = false
    return true
end

local function cycle_manual_cap()
    local old_factor = active_factor
    local old_model = active_model
    manual_index = manual_index + 1
    if manual_index > #manual_modes then
        manual_index = 1
    end
    active_factor = nil
    active_model = nil
    if not apply() then
        active_factor = old_factor
        active_model = old_model
    end
end

mp.add_key_binding("F9", "cycle-rife-factor", cycle_manual_cap)
mp.observe_property("width", "native", apply)
mp.observe_property("height", "native", apply)
mp.observe_property("container-fps", "native", apply)
mp.observe_property("estimated-vf-fps", "native", apply)
mp.observe_property("display-fps", "native", apply)
mp.observe_property("vf", "native", apply)
mp.register_event("file-loaded", apply)
