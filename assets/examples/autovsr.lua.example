local mp = require("mp")
local msg = require("mp.msg")
local utils = require("mp.utils")

local applying = false
local last_scale = nil
local vsr_enabled = true

local function current_script_dir()
    local ok, dir = pcall(mp.get_script_directory)
    if dir then return dir end
    local source = debug.getinfo(1, "S").source
    if source and source:sub(1, 1) == "@" then
        return source:sub(2):match("^(.*)[/\\][^/\\]+$")
    end
    return "."
end

local script_dir = current_script_dir()
local config_dir = utils.join_path(script_dir, "..")

local function has_vsr(vf)
    return vf and string.find(vf, "@vsr", 1, true) ~= nil
end

local function has_downsampled_rife(vf)
    return vf and string.find(vf, "down1080", 1, true) ~= nil
end

local function supported_format(fmt)
    return fmt == "nv12" or fmt == "p010" or fmt == "yuv420p" or fmt == "yuv420p10"
end

local function read_runtime_conf()
    local conf = {}
    local path = mp.find_config_file("runtime.conf") or utils.join_path(config_dir, "runtime.conf")
    if not path then
        return conf
    end

    local f = io.open(path, "r")
    if not f then
        return conf
    end
    for line in f:lines() do
        local key, value = line:match("^%s*([%w_%-]+)%s*=%s*(.-)%s*$")
        if key and not key:match("^#") then
            conf[key] = value
        end
    end
    f:close()
    return conf
end

local function bool_enabled(value, default)
    if value == nil or value == "" then
        return default
    end
    value = tostring(value):lower()
    return value == "1" or value == "yes" or value == "true" or value == "on"
end

local function initialize_runtime_flags()
    local conf = read_runtime_conf()
    vsr_enabled = bool_enabled(conf.enable_vsr, true)
end

local function read_target_dims()
    local conf = read_runtime_conf()
    local cw = tonumber(conf.vsr_target_w or "")
    local ch = tonumber(conf.vsr_target_h or "")
    if cw and ch and cw > 0 and ch > 0 then
        return cw, ch
    end

    local w = tonumber(os.getenv("VSR_TARGET_W") or "")
    local h = tonumber(os.getenv("VSR_TARGET_H") or "")
    if w and h and w > 0 and h > 0 then
        return w, h
    end
    return mp.get_property_native("display-width"), mp.get_property_native("display-height")
end

local function compute_fit_scale(video_width, video_height, display_width, display_height)
    local sw = display_width / video_width
    local sh = display_height / video_height
    local scale = math.min(sw, sh)
    scale = math.floor(scale * 10) / 10
    if scale > 4.0 then
        scale = 4.0
    end
    return scale
end

local function autovsr()
    if applying then
        return
    end

    local display_width, display_height = read_target_dims()
    local video_width = mp.get_property_native("width")
    local video_height = mp.get_property_native("height")
    local pixfmt = mp.get_property_native("video-params/hw-pixelformat") or mp.get_property_native("video-params/pixelformat")
    local vf = mp.get_property("vf")

    if not vsr_enabled then
        if has_vsr(vf) then
            applying = true
            mp.commandv("vf", "remove", "@vsr")
            last_scale = nil
            applying = false
        end
        return
    end

    if not video_width or not video_height then
        return
    end

    local downsampled_rife = has_downsampled_rife(vf)
    if (not display_width or not display_height) and downsampled_rife then
        display_width = video_width
        display_height = video_height
    end
    if not display_width or not display_height then
        return
    end

    local effective_width = video_width
    local effective_height = video_height
    if downsampled_rife and video_height > 1080 then
        effective_height = 1080
        effective_width = math.floor((video_width * effective_height) / video_height)
        if effective_width % 2 == 1 then
            effective_width = effective_width - 1
        end
    end

    local source_is_1080p_or_lower = video_width <= 1920 and video_height <= 1080
    local scale = compute_fit_scale(effective_width, effective_height, display_width, display_height)
    if (source_is_1080p_or_lower or downsampled_rife) and scale > 1.0 and (downsampled_rife or supported_format(pixfmt)) then
        if has_vsr(vf) and last_scale == scale then
            return
        end
        applying = true
        if has_vsr(vf) then
            mp.commandv("vf", "remove", "@vsr")
        end
        msg.info(string.format(
            "NVIDIA VSR: source %dx%d, target %dx%d, scale %.1fx",
            effective_width, effective_height, display_width, display_height, scale))
        mp.commandv("vf", "append", "@vsr:d3d11vpp=scale=" .. scale .. ":scaling-mode=nvidia")
        last_scale = scale
        applying = false
        return
    end

    if has_vsr(vf) and video_height > 1080 then
        return
    end

    if has_vsr(vf) then
        applying = true
        mp.commandv("vf", "remove", "@vsr")
        last_scale = nil
        msg.info("NVIDIA VSR: disabled for current source/target")
        applying = false
    end
end

local function schedule_autovsr()
    autovsr()
    mp.add_timeout(0.25, function()
        autovsr()
    end)
end

local function toggle_vsr()
    vsr_enabled = not vsr_enabled
    if not vsr_enabled then
        if has_vsr(mp.get_property("vf")) then
            applying = true
            mp.commandv("vf", "remove", "@vsr")
            applying = false
        end
        last_scale = nil
        mp.osd_message("NVIDIA VSR: off", 1.5)
        msg.info("NVIDIA VSR manually disabled")
    else
        mp.osd_message("NVIDIA VSR: on", 1.5)
        msg.info("NVIDIA VSR manually enabled")
        schedule_autovsr()
    end
end

initialize_runtime_flags()
mp.add_key_binding("F8", "toggle-nvidia-vsr", toggle_vsr)
mp.observe_property("display-width", "native", schedule_autovsr)
mp.observe_property("display-height", "native", schedule_autovsr)
mp.observe_property("width", "native", schedule_autovsr)
mp.observe_property("height", "native", schedule_autovsr)
mp.observe_property("video-params/pixelformat", "native", schedule_autovsr)
mp.observe_property("video-params/hw-pixelformat", "native", schedule_autovsr)
mp.observe_property("vf", "native", schedule_autovsr)
mp.register_event("video-reconfig", schedule_autovsr)
mp.register_event("file-loaded", schedule_autovsr)
