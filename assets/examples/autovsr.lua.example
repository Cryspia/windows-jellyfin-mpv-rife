local mp = require("mp")
local msg = require("mp.msg")

local applying = false
local last_scale = nil

local function current_script_dir()
    local ok, dir = pcall(mp.get_script_directory)
    if dir then return dir end
    local source = debug.getinfo(1, "S").source
    if source and source:sub(1, 1) == "@" then
        return source:match("^(.*)[/\\][^/\\]+$")
    end
    return "."
end

local script_dir = current_script_dir()
local config_dir = require("mp.utils").join_path(script_dir, "..")

local function has_vsr(vf)
    return vf and string.find(vf, "@vsr", 1, true) ~= nil
end

local function supported_format(fmt)
    return fmt == "nv12" or fmt == "p010" or fmt == "yuv420p" or fmt == "yuv420p10"
end

local function read_runtime_conf()
    local conf = {}
    local path = mp.find_config_file("runtime.conf") or require("mp.utils").join_path(config_dir, "runtime.conf")
    if not path then
        return conf
    end

    local f = io.open(path, "r")
    if not f then
        return conf
    end
    for line in f:lines() do
        local key, value = line:match("^%s*([%w_%-]+)%s*=%s*(.-)%s*$")
        if key and not key:match("^#") then
            conf[key] = value
        end
    end
    f:close()
    return conf
end

local function read_target_dims()
    local conf = read_runtime_conf()
    local cw = tonumber(conf.vsr_target_w or "")
    local ch = tonumber(conf.vsr_target_h or "")
    if cw and ch and cw > 0 and ch > 0 then
        return cw, ch
    end

    local w = tonumber(os.getenv("VSR_TARGET_W") or "")
    local h = tonumber(os.getenv("VSR_TARGET_H") or "")
    if w and h and w > 0 and h > 0 then
        return w, h
    end
    return mp.get_property_native("display-width"), mp.get_property_native("display-height")
end

local function compute_fit_scale(video_width, video_height, display_width, display_height)
    local sw = display_width / video_width
    local sh = display_height / video_height
    local scale = math.min(sw, sh)
    scale = math.floor(scale * 10) / 10
    if scale > 4.0 then
        scale = 4.0
    end
    return scale
end

local function autovsr()
    if applying then
        return
    end

    local display_width, display_height = read_target_dims()
    local video_width = mp.get_property_native("width")
    local video_height = mp.get_property_native("height")
    local pixfmt = mp.get_property_native("video-params/hw-pixelformat") or mp.get_property_native("video-params/pixelformat")
    local vf = mp.get_property("vf")

    if not display_width or not display_height or not video_width or not video_height then
        return
    end

    local source_is_1080p_or_lower = video_width <= 1920 and video_height <= 1080
    local scale = compute_fit_scale(video_width, video_height, display_width, display_height)
    if source_is_1080p_or_lower and scale > 1.0 and supported_format(pixfmt) then
        if has_vsr(vf) and last_scale == scale then
            return
        end
        applying = true
        if has_vsr(vf) then
            mp.commandv("vf", "remove", "@vsr")
        end
        msg.info(string.format(
            "NVIDIA VSR: source %dx%d, target %dx%d, scale %.1fx",
            video_width, video_height, display_width, display_height, scale))
        mp.commandv("vf", "append", "@vsr:d3d11vpp=scale=" .. scale .. ":scaling-mode=nvidia")
        last_scale = scale
        applying = false
        return
    end

    if has_vsr(vf) then
        applying = true
        mp.commandv("vf", "remove", "@vsr")
        last_scale = nil
        msg.info("NVIDIA VSR: disabled for current source/target")
        applying = false
    end
end

mp.observe_property("display-width", "native", autovsr)
mp.observe_property("display-height", "native", autovsr)
mp.observe_property("width", "native", autovsr)
mp.observe_property("height", "native", autovsr)
mp.observe_property("video-params/pixelformat", "native", autovsr)
mp.observe_property("video-params/hw-pixelformat", "native", autovsr)
mp.observe_property("vf", "native", autovsr)
mp.register_event("file-loaded", autovsr)
