# Windows mpv config for NVIDIA d3d11vpp RTX Video Super Resolution + RIFE.
# Persistent path: config/mpv/mpv.conf

vo=gpu-next
gpu-api=d3d11
gpu-context=d3d11
d3d11-exclusive-fs=no
d3d11-flip=no
hwdec=d3d11va
profile=gpu-hq

video-sync=display-resample
interpolation=no
tscale=oversample

scale=ewa_lanczossharp
cscale=ewa_lanczossharp
dscale=mitchell
correct-downscaling=yes
linear-downscaling=yes
sigmoid-upscaling=yes
deband=yes
target-colorspace-hint=yes
dither-depth=auto

secondary-sub-ass-override=no
secondary-sub-pos=0

# Windows default: scripts/autorife.lua manages RIFE and scripts/autovsr.lua
# appends @vsr:d3d11vpp after any RIFE vf.
# If NVIDIA VSR is off, enable it in NVIDIA App / Control Panel.
