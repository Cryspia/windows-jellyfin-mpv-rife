import argparse
import ctypes
import os
from pathlib import Path
import re
import sys
import time
import traceback
from uuid import uuid4


def _configure_background_limits() -> None:
    for key in (
        "OMP_NUM_THREADS",
        "MKL_NUM_THREADS",
        "OPENBLAS_NUM_THREADS",
        "NUMEXPR_NUM_THREADS",
        "VECLIB_MAXIMUM_THREADS",
        "TORCH_NUM_THREADS",
    ):
        os.environ.setdefault(key, "1")
    os.environ.setdefault("CUDA_MODULE_LOADING", "LAZY")

    if os.name == "nt":
        try:
            kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
            kernel32.GetCurrentProcess.restype = ctypes.c_void_p
            kernel32.SetPriorityClass.argtypes = (ctypes.c_void_p, ctypes.c_uint32)
            kernel32.SetPriorityClass.restype = ctypes.c_int
            handle = kernel32.GetCurrentProcess()
            if not kernel32.SetPriorityClass(handle, 0x00000040):  # IDLE_PRIORITY_CLASS
                kernel32.SetPriorityClass(handle, 0x00004000)  # BELOW_NORMAL_PRIORITY_CLASS
        except Exception:
            pass


def _profile_label(model: str, scale: float, downsample_1080: bool) -> str:
    if downsample_1080:
        return "4.26-down1080"
    if model == "4.26" and abs(scale - 0.5) < 1e-6:
        return "4.26-half"
    return model


def _scale_label(scale: float) -> str:
    if abs(scale - 1.0) < 1e-6:
        return "1"
    if abs(scale - 0.5) < 1e-6:
        return "0.5"
    return ("%g" % scale)


def _effective_dimensions(width: int, height: int, downsample_1080: bool) -> tuple[int, int]:
    if downsample_1080 and height > 1080:
        effective_height = 1080
        effective_width = (width * effective_height) // height
        if effective_width % 2:
            effective_width -= 1
        return effective_width, effective_height
    return width, height


def main() -> int:
    parser = argparse.ArgumentParser(description="Build a RIFE TensorRT engine cache for one runtime profile.")
    parser.add_argument("--width", type=int, required=True)
    parser.add_argument("--height", type=int, required=True)
    parser.add_argument("--model", default="4.26")
    parser.add_argument("--factor", type=int, default=2)
    parser.add_argument("--scale", type=float, default=1.0)
    parser.add_argument("--downsample-1080", action="store_true")
    parser.add_argument("--config-dir", required=True)
    parser.add_argument("--cache-dir", required=True)
    parser.add_argument("--namespace", required=True)
    args = parser.parse_args()
    if not re.fullmatch(r"v1-[A-Za-z0-9._-]+", args.namespace):
        parser.error("invalid RIFE cache namespace")
    if args.model != "4.26":
        parser.error("unsupported RIFE model")
    cache_dir = Path(args.cache_dir) / args.namespace
    cache_dir.mkdir(parents=True, exist_ok=True)
    width, height = _effective_dimensions(args.width, args.height, args.downsample_1080)
    label = _profile_label(args.model, args.scale, args.downsample_1080)
    key = f"{label}-scale-{_scale_label(args.scale)}-{width}x{height}"
    marker = cache_dir / ".validated" / f"{key}.ok"
    marker.parent.mkdir(parents=True, exist_ok=True)
    marker.unlink(missing_ok=True)
    _configure_background_limits()
    sys.stdout = (cache_dir / f"{key}.build.log").open("a", encoding="utf-8", buffering=1)
    sys.stderr = (cache_dir / f"{key}.build.err.log").open("a", encoding="utf-8", buffering=1)
    os.environ["RIFE_TRT_CACHE_DIR"] = args.cache_dir
    os.environ["RIFE_ALLOW_INLINE_TRT_BUILD"] = "1"
    os.environ["RIFE_VALIDATE_OUTPUT"] = "1"
    try:
        _build(args)
    except Exception:
        traceback.print_exc()
        marker.with_suffix(".ok.failed").write_text("see build logs\n", encoding="utf-8")
        return 1
    pending = marker.with_name(f"{marker.name}.{uuid4().hex}.tmp")
    pending.write_text("ok\n", encoding="utf-8")
    pending.replace(marker)
    marker.with_suffix(".ok.failed").unlink(missing_ok=True)
    return 0


def _build(args) -> None:
    sys.path.insert(0, args.config_dir)
    import vapoursynth as vs

    from rife_backend import cache_dir, profile
    from rife_vpy_common import run_rife_profile
    info = profile()
    if info["namespace"] != args.namespace or info["backend"] == "torch":
        raise RuntimeError("Requested cache does not match installed TensorRT backend")
    print(f"RIFE {info['backend']} {info['version']} / {info['precision']}: {cache_dir()}")

    core = vs.core
    base = core.std.BlankClip(
        width=args.width,
        height=args.height,
        format=vs.YUV420P10,
        length=1,
        fpsnum=24,
        fpsden=1,
        color=[512, 512, 512],
    )
    base = core.std.SetFrameProps(base, _Matrix=1, _ColorRange=1)
    other = core.std.SetFrameProps(core.std.BlankClip(base, color=[544, 512, 512]),
                                   _Matrix=1, _ColorRange=1)
    source = (base + other) * 12
    clip = run_rife_profile(
        source,
        model=args.model,
        scale=args.scale,
        factor_num=args.factor,
        factor_den=1,
        downsample_1080=args.downsample_1080,
        strict=True,
    )
    if clip.fps != source.fps * args.factor:
        raise RuntimeError("RIFE validation did not produce interpolated frames")

    # Pull enough frames to force TensorRT engine build and run one warmed group.
    for frame_no in range(min(clip.num_frames, max(args.factor * 3, 8))):
        clip.get_frame(frame_no)
        time.sleep(0.02)


if __name__ == "__main__":
    raise SystemExit(main())
