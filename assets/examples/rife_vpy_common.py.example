import os
from pathlib import Path
import sys

import vapoursynth as vs

core = vs.core
_MISSING_TRT_CACHE = "RIFE_MISSING_TRT_CACHE"

_P10_FORMAT_BY_SUBSAMPLING = {
    "420": vs.YUV420P10,
    "422": vs.YUV422P10,
    "444": vs.YUV444P10,
}


def _cache_dir() -> Path:
    override = os.environ.get("RIFE_TRT_CACHE_DIR")
    if override:
        trt_cache_dir = Path(override)
        trt_cache_dir.mkdir(parents=True, exist_ok=True)
        return trt_cache_dir
    trt_cache_dir = Path(__file__).resolve().parents[1] / "cache" / "rife-trt"
    trt_cache_dir.mkdir(parents=True, exist_ok=True)
    return trt_cache_dir


def _runtime_conf() -> dict[str, str]:
    path = Path(__file__).resolve().parent / "runtime.conf"
    conf: dict[str, str] = {}
    try:
        for raw in path.read_text(encoding="utf-8").splitlines():
            line = raw.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            conf[key.strip()] = value.strip()
    except OSError:
        pass
    return conf


def _output_subsampling(source: vs.VideoNode) -> str:
    value = _runtime_conf().get("rife_output_subsampling", "source").lower()
    if value in _P10_FORMAT_BY_SUBSAMPLING:
        return value
    if (
        value == "source"
        and source.format is not None
        and source.format.color_family == vs.YUV
        and source.format.bits_per_sample == 10
        and source.format.sample_type == vs.INTEGER
        and source.format.subsampling_w in (0, 1)
        and source.format.subsampling_h in (0, 1)
    ):
        if source.format.subsampling_w == 0 and source.format.subsampling_h == 0:
            return "444"
        if source.format.subsampling_w == 1 and source.format.subsampling_h == 0:
            return "422"
    return "420"


def _gpu_input(clip: vs.VideoNode) -> vs.VideoNode:
    if clip.format is None or clip.format.color_family != vs.YUV:
        raise RuntimeError("GPU RIFE path expects YUV input")

    direct_p10 = (
        clip.format.bits_per_sample == 10
        and clip.format.sample_type == vs.INTEGER
        and clip.format.subsampling_w in (0, 1)
        and clip.format.subsampling_h in (0, 1)
    )

    if not direct_p10:
        # 420/422/444 P10 can enter the GPU helper directly. Other bit
        # depths or unusual subsampling are normalised first so the helper
        # never has to reinterpret an unknown plane layout.
        clip = core.resize.Bicubic(clip, format=vs.YUV420P10)
    return clip


def _cpu_rife(
    source: vs.VideoNode,
    *,
    model: str,
    scale: float,
    factor_num: int,
    factor_den: int,
    width: int | None = None,
    height: int | None = None,
) -> vs.VideoNode:
    if os.environ.get("RIFE_ALLOW_INLINE_TRT_BUILD") != "1":
        raise RuntimeError(_MISSING_TRT_CACHE)

    from vsrife import rife

    resize_args = {
        "format": vs.RGBH,
    }
    if width is not None:
        resize_args["width"] = width
    if height is not None:
        resize_args["height"] = height
    clip = core.resize.Bicubic(source, **resize_args)
    clip = rife(
        clip,
        model=model,
        scale=scale,
        factor_num=factor_num,
        factor_den=factor_den,
        auto_download=False,
        trt=True,
        trt_cache_dir=str(_cache_dir()),
    )
    out_format = _P10_FORMAT_BY_SUBSAMPLING[_output_subsampling(source)]

    return core.resize.Bicubic(
        clip,
        format=out_format,
    )


def run_rife_profile(
    source: vs.VideoNode,
    *,
    model: str = "4.26",
    scale: float = 1.0,
    factor_num: int = 2,
    factor_den: int = 1,
    downsample_1080: bool = False,
) -> vs.VideoNode:
    target_w = None
    target_h = None
    if downsample_1080:
        target_h = 1080
        target_w = ((source.width * target_h) // source.height) & ~1

    try:
        gpu_clip = _gpu_input(source)
        if downsample_1080:
            from vs_gpu_helpers import downsample_yuvp10_gpu, rife_yuv

            gpu_clip = downsample_yuvp10_gpu(
                gpu_clip,
                width=target_w,
                height=target_h,
            )
        else:
            from vs_gpu_helpers import rife_yuv

        return rife_yuv(
            gpu_clip,
            model=model,
            scale=scale,
            factor_num=factor_num,
            factor_den=factor_den,
            output_subsampling=_output_subsampling(source),
        )
    except Exception as gpu_exc:
        if _MISSING_TRT_CACHE in str(gpu_exc) or "TensorRT cache is missing" in str(gpu_exc):
            raise
        try:
            return _cpu_rife(
                source,
                model=model,
                scale=scale,
                factor_num=factor_num,
                factor_den=factor_den,
                width=target_w,
                height=target_h,
            )
        except Exception as cpu_exc:
            if _MISSING_TRT_CACHE in str(cpu_exc):
                raise
            fmt_name = getattr(source.format, "name", "?")
            sys.stderr.write(
                f"[rife.vpy] GPU path failed for {fmt_name}: "
                f"{type(gpu_exc).__name__}: {gpu_exc}; "
                f"CPU fallback failed: {type(cpu_exc).__name__}: {cpu_exc}; "
                "passing through source\n"
            )
            return source
